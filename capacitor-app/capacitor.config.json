{
  "appId": "com.servialiados.repartidor",
  "appName": "Servi Aliados Repartidor",
  "webDir": "www",
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": false,
      "providers": ["google.com"]
    },
    "CapacitorHttp": {
      "enabled": true
    },
    "BackgroundRunner": {
      "label": "com.servialiados.repartidor.background.task",
      "src": "runners/background.js",
      "event": "servialiadosHeartbeat",
      "repeat": true,
      "interval": 15,
      "autoStart": true
    }
  }
}
